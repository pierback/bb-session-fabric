{
  "name": "bb-plugin-session-fabric",
  "version": "0.1.0",
  "description": "Inspect and operate BB portable provider sessions from a thread panel and CLI.",
  "license": "MIT",
  "homepage": "https://github.com/pierback/bb-session-fabric#readme",
  "bugs": {
    "url": "https://github.com/pierback/bb-session-fabric/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pierback/bb-session-fabric.git"
  },
  "type": "module",
  "files": [
    "dist",
    "server.ts",
    "cli.ts",
    "connection-view.ts",
    "contract.ts",
    "handoff-audit-snapshot-store.ts",
    "app.tsx",
    "connection-details.tsx",
    "components",
    "lib",
    "types",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.19.0",
    "bb": ">=0.36 <0.37",
    "bbPluginSdk": "^0.4.1"
  },
  "bb": {
    "name": "Session Fabric",
    "description": "Inspect and operate portable provider sessions without moving runtime authority out of BB core.",
    "branding": {
      "icon": "Workflow"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "keywords": [
    "bb-plugin",
    "sessions",
    "orchestration"
  ],
  "scripts": {
    "build": "npm run types:check && bb plugin build",
    "check": "npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "types:check": "bb plugin types --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.1",
    "prettier": "^3.8.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.1"
  }
}
